# NeuroSentinel Security Service Configuration
# Copy to .env in project root for deployment

# ===== REDIS CONFIGURATION =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=neurosentinel_redis_2026

# ===== OLLAMA CONFIGURATION =====
OLLAMA_BASE_URL=http://localhost:11434/api/generate
TARGET_MODEL=phi3:mini
EMBEDDING_MODEL=nomic-embed-text

# ===== HUGGINGFACE EMBEDDINGS (RECOMMENDED) =====
# Get your free API key from: https://huggingface.co/settings/tokens
# This provides real semantic embeddings instead of mock embeddings
# Without this, general queries like "What is the weather?" will trigger false positives
HF_API_KEY=hf_your_token_here

# ===== GROQ API (Optional - for cloud LLM) =====
# Get from: https://console.groq.com/keys
GROQ_API_KEY=

# ===== SERVICE CONFIGURATION =====
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=info
DEBUG=false

# ===== DATA STORAGE =====
RAW_DATA_DIR=data
SECURITY_LOG_FILE=data/telemetry_stream.json

# ===== FEATURE EXTRACTION =====
SLIDING_WINDOW_SIZE=5
FEATURE_DIMENSION=4

# ===== LLM PROVIDER OVERRIDE (optional) =====
# For custom LLM endpoints, set these:
# LLM_PROVIDER=openai|claude|custom|ollama
# OPENAI_API_KEY=sk-xxx
# CLAUDE_API_KEY=xxx
# CUSTOM_LLM_ENDPOINT=https://your-api.com/v1/generate