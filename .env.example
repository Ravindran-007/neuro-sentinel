# NeuroSentinel Security Service Configuration
# Copy to .env in project root for deployment

# ===== REDIS CONFIGURATION =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your_redis_password_here

# ===== SECURITY & ADMIN AUTHENTICATION =====
ADMIN_API_KEY=
CORS_ALLOWED_ORIGINS=https://neurosentinel.vercel.app,http://localhost:3000,http://localhost:8000
RATE_LIMIT_PER_MINUTE=240

# ===== OLLAMA CONFIGURATION =====
OLLAMA_BASE_URL=http://localhost:11434/api/generate
TARGET_MODEL=phi3:mini
EMBEDDING_MODEL=nomic-embed-text

# ===== HUGGINGFACE EMBEDDINGS (RECOMMENDED) =====
# Get your free API key from: https://huggingface.co/settings/tokens
# This provides real semantic embeddings instead of mock embeddings
# Without this, general queries like "What is the weather?" will trigger false positives
HF_API_KEY=hf_your_token_here

# ===== GROQ API (Optional - for cloud LLM) =====
# Get from: https://console.groq.com/keys
GROQ_API_KEY=
# Model order: GROQ_MODEL first, then GROQ_FALLBACK_MODELS. Check live IDs with
# GET https://api.groq.com/openai/v1/models (Groq retires models regularly).
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b
# gpt-oss models spend tokens on hidden reasoning; keep this >= 800.
GROQ_MAX_TOKENS=800
# Optional: low | medium | high (sent to openai/gpt-oss-* models only)
GROQ_REASONING_EFFORT=
GROQ_TIMEOUT=15
GROQ_TOTAL_BUDGET=40

# ===== SCORING =====
# Only the first N characters of an LLM reply are scored (the structural model
# was trained on short outputs). A single layer must exceed its limit by
# MARGIN_RATIO before the result is SUSPICIOUS.
SCORING_MAX_CHARS=400
MARGIN_RATIO=1.25

# ===== SERVICE CONFIGURATION =====
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=info
DEBUG=false

# ===== DATA STORAGE =====
RAW_DATA_DIR=data
SECURITY_LOG_FILE=data/telemetry_stream.json

# ===== FEATURE EXTRACTION =====
SLIDING_WINDOW_SIZE=5
FEATURE_DIMENSION=4

# ===== LLM PROVIDER OVERRIDE (optional) =====
# For custom LLM endpoints, set these:
# LLM_PROVIDER=openai|claude|custom|ollama
# OPENAI_API_KEY=sk-xxx
# CLAUDE_API_KEY=xxx
# CUSTOM_LLM_ENDPOINT=https://your-api.com/v1/generate

# ===== SEMANTIC LAYER =====
# Real embeddings need HF_API_KEY. Without them the semantic layer is SKIPPED
# (the built-in mock only counts vocabulary matches and is not semantic).
# Set SEMANTIC_ALLOW_MOCK=true only for local experiments.
SEMANTIC_ALLOW_MOCK=false
# Override if Hugging Face changes its inference endpoint:
HF_EMBEDDING_URL=
